#: ../../appdev/platform/apparmor.rst:247
msgid "sensors"
msgstr "ເຊັນເຊີ (sensors)"

#: ../../appdev/platform/apparmor.rst:249
msgid "Description: Can access the sensors"
msgstr "ຄຳອະທິບາຍ: ສາມາດເຂົ້າເຖິງເຊັນເຊີ"

#: ../../appdev/platform/apparmor.rst:253
msgid "Allows apps to access `device sensors`_"
msgstr "ອະນຸຍາດໃຫ້ແອັບເຂົ້າເຖິງ `ເຊັນເຊີຂອງອຸປະກອນ`_"

#: ../../appdev/platform/apparmor.rst:257
msgid "usermetrics"
msgstr "ການວັດແທກຂອງຜູ້ໃຊ້ (usermetrics)"

